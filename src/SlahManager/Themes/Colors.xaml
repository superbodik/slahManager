<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="BackgroundBrush" Color="#0B0B0B"/>
    <SolidColorBrush x:Key="SidebarBrush" Color="#070707"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#111111"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#161616"/>

    <SolidColorBrush x:Key="LineBrush" Color="#1D1D1D"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#2E2E2E"/>
    <SolidColorBrush x:Key="LineHoverBrush" Color="#444444"/>

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8E8E8E"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#5A5A5A"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#ECECEC"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#0B0B0B"/>

    <SolidColorBrush x:Key="PositiveBrush" Color="#7FA886"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#C4A265"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#C06C6C"/>

</ResourceDictionary>
