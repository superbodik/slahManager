<Window x:Class="SlahManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SlahManager.Localization"
        Title="slahManager"
        Width="1120"
        Height="720"
        MinWidth="940"
        MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}"
        FontSize="13"
        TextOptions.TextRenderingMode="Grayscale"
        UseLayoutRounding="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="36"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource SidebarBrush}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                <TextBlock Text="slahManager"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}"/>
                <TextBlock Text="{Binding Version}"
                           Margin="10,0,0,0"
                           FontFamily="{StaticResource MonoFont}"
                           FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE921;"
                        Click="OnMinimize"/>
                <Button x:Name="MaximizeButton"
                        Style="{StaticResource CaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE922;"
                        Click="OnMaximizeRestore"/>
                <Button Style="{StaticResource CloseCaptionButton}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Content="&#xE8BB;"
                        Click="OnClose"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource SidebarBrush}"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <ListBox Grid.Row="0"
                             Margin="0,28,0,0"
                             Style="{StaticResource NavList}"
                             ItemsSource="{Binding Pages}"
                             SelectedItem="{Binding CurrentPage, Mode=TwoWay}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <TextBlock Text="{Binding Title}" HorizontalAlignment="Left"/>
                                    <TextBlock Text="{Binding Badge}"
                                               HorizontalAlignment="Right"
                                               FontFamily="{StaticResource MonoFont}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextMutedBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="1" Margin="28,0,24,24">
                        <TextBlock Text="{Binding MachineName}" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding PrivilegeLabel}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource LabelText}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Padding="48,12"
                            Background="{StaticResource SidebarBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1"
                            Visibility="{Binding ShowElevationNotice, Converter={StaticResource BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="6"
                                    Height="6"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource WarningBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,24,0"
                                       VerticalAlignment="Center"
                                       Text="{loc:Loc notice.notElevated}"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Button Grid.Column="2"
                                    Content="{loc:Loc notice.restartElevated}"
                                    Padding="14,6"
                                    FontSize="12"
                                    Style="{StaticResource GhostButton}"
                                    Command="{Binding RestartElevatedCommand}"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1">
                        <ContentControl Content="{Binding CurrentPage}"
                                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}"/>
                        <TextBlock Text="{loc:Loc loading.scanning}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource LabelText}"
                                   Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
