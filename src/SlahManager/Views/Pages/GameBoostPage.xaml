<UserControl x:Class="SlahManager.Views.Pages.GameBoostPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SlahManager.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,56" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="{loc:Loc boost.subtitle}" Style="{StaticResource SubtitleText}"/>

            <Border Margin="0,36,0,0"
                    Padding="0,28"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <TextBlock Text="{loc:Loc boost.section.status}" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding StatusTitle}"
                                   Margin="0,12,0,0"
                                   Style="{StaticResource HeadlineText}"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding StatusDetail}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding FixStatusMessage}"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource CaptionMono}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Visibility="{Binding HasFixStatus, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <Button Grid.Column="1"
                            MinWidth="210"
                            VerticalAlignment="Center"
                            Content="{loc:Loc boost.fix.button}"
                            Command="{Binding FixCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                </Grid>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc boost.section.options}"
                       Style="{StaticResource LabelText}"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc boost.master}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc boost.master.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc boost.timer}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc boost.timer.description}"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{loc:Loc boost.timer.hint}"
                                           Style="{StaticResource CaptionMono}"
                                           Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding ShowTimerHint, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding BoostTimer, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc boost.priority}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc boost.priority.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding BoostPriority, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc boost.power}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc boost.power.description}"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Margin="0,10,0,0"
                                           Text="{loc:Loc boost.power.hint}"
                                           Style="{StaticResource CaptionMono}"
                                           Foreground="{StaticResource WarningBrush}"
                                           Visibility="{Binding ShowPowerHint, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding BoostPower, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc boost.wifi}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc boost.wifi.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding BoostWifi, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc boost.section.cs2}"
                       Style="{StaticResource LabelText}"/>
            <Border Padding="0,20"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,40,0">
                            <TextBlock Text="{loc:Loc boost.vibrance}" FontSize="14"/>
                            <TextBlock Margin="0,5,0,0"
                                       Text="{loc:Loc boost.vibrance.description}"
                                       Style="{StaticResource BodyText}"/>
                            <TextBlock Margin="0,10,0,0"
                                       Text="{Binding VibranceNow}"
                                       Style="{StaticResource LabelText}"/>
                        </StackPanel>
                        <ToggleButton Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource SwitchToggle}"
                                      IsEnabled="{Binding HasVibranceSupport}"
                                      IsChecked="{Binding Cs2Vibrance, Mode=TwoWay}"/>
                    </Grid>

                    <Border Margin="0,16,0,0"
                            Padding="2"
                            HorizontalAlignment="Left"
                            BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Visibility="{Binding Cs2Vibrance, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl ItemsSource="{Binding VibranceOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <RadioButton MinWidth="64"
                                                 GroupName="VibranceLevel"
                                                 Content="{Binding Label}"
                                                 IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                 Style="{StaticResource SegmentedButton}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc ping.section}"
                       Style="{StaticResource LabelText}"/>
            <Border Padding="0,20"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,40,0">
                        <TextBlock Text="{loc:Loc ping.title}" FontSize="14"/>
                        <TextBlock Margin="0,5,0,0"
                                   Text="{loc:Loc ping.description}"
                                   Style="{StaticResource BodyText}"/>
                        <StackPanel Margin="0,14,0,0"
                                    Visibility="{Binding HasPingResult, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding PingConnection}" Style="{StaticResource LabelText}"/>
                            <TextBlock Margin="0,8,0,0" Text="{Binding PingRouter}" Style="{StaticResource CaptionMono}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Margin="0,4,0,0" Text="{Binding PingInternet}" Style="{StaticResource CaptionMono}" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Margin="0,10,0,0" Text="{Binding PingAdvice}" Style="{StaticResource BodyText}"/>
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1"
                            MinWidth="140"
                            VerticalAlignment="Top"
                            Content="{Binding PingButtonLabel}"
                            Command="{Binding PingCommand}"
                            Style="{StaticResource GhostButton}"/>
                </Grid>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc boost.section.games}"
                       Style="{StaticResource LabelText}"/>
            <Border Padding="0,0,0,20"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel>
                    <TextBlock Margin="0,20,0,16"
                               Text="{loc:Loc boost.games.description}"
                               Style="{StaticResource BodyText}"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Style="{StaticResource FlatTextBox}"
                                 Text="{Binding NewGameName, UpdateSourceTrigger=PropertyChanged}">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddGameCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1"
                                Margin="10,0,0,0"
                                MinWidth="110"
                                Content="{loc:Loc boost.games.add}"
                                Command="{Binding AddGameCommand}"
                                Style="{StaticResource GhostButton}"/>
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Text="{loc:Loc boost.games.example}"
                               Style="{StaticResource LabelText}"/>

                    <ItemsControl Margin="0,16,0,0" ItemsSource="{Binding CustomGames}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="0,10"
                                        BorderBrush="{StaticResource LineBrush}"
                                        BorderThickness="0,1,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12.5"/>
                                        <Button Grid.Column="1"
                                                Padding="14,6"
                                                FontSize="12"
                                                Content="{loc:Loc boost.games.remove}"
                                                Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
