<UserControl x:Class="SlahManager.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SlahManager.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,56" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="{loc:Loc settings.subtitle}" Style="{StaticResource SubtitleText}"/>

            <TextBlock Margin="0,36,0,14"
                       Text="{loc:Loc settings.section.general}"
                       Style="{StaticResource LabelText}"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.language}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.language.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="2"
                                    VerticalAlignment="Center"
                                    BorderBrush="{StaticResource LineStrongBrush}"
                                    BorderThickness="1"
                                    CornerRadius="5">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="English"
                                                 GroupName="Language"
                                                 Style="{StaticResource SegmentedButton}"
                                                 IsChecked="{Binding IsEnglish, Mode=TwoWay}"/>
                                    <RadioButton Content="Русский"
                                                 GroupName="Language"
                                                 Style="{StaticResource SegmentedButton}"
                                                 IsChecked="{Binding IsRussian, Mode=TwoWay}"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.restorePoint}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.restorePoint.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding CreateRestorePoint, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.tray}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.tray.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding RunInTray, Mode=TwoWay}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.startup}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.startup.description}"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding StatusMessage}"
                                           Style="{StaticResource CaptionMono}"
                                           Foreground="{StaticResource DangerBrush}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource SwitchToggle}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc settings.section.maintenance}"
                       Style="{StaticResource LabelText}"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.revertAll}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.revertAll.description}"
                                           Style="{StaticResource BodyText}"/>
                                <TextBlock Margin="0,12,0,0"
                                           Text="{Binding StatusMessage}"
                                           Style="{StaticResource CaptionMono}"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="120"
                                    Content="{loc:Loc settings.revertAll.button}"
                                    Command="{Binding RevertAllCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </Grid>
                    </Border>

                    <Border Padding="0,20"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,40,0">
                                <TextBlock Text="{loc:Loc settings.logs}" FontSize="14"/>
                                <TextBlock Margin="0,5,0,0"
                                           Text="{loc:Loc settings.logs.description}"
                                           Style="{StaticResource BodyText}"/>
                            </StackPanel>
                            <Button Grid.Column="1"
                                    VerticalAlignment="Center"
                                    MinWidth="120"
                                    Content="{loc:Loc settings.logs.button}"
                                    Command="{Binding OpenLogsCommand}"
                                    Style="{StaticResource GhostButton}"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Margin="0,44,0,14"
                       Text="{loc:Loc settings.section.about}"
                       Style="{StaticResource LabelText}"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <StackPanel>
                    <Border Padding="0,13"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc settings.version}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Version}"/>
                        </Grid>
                    </Border>
                    <Border Padding="0,13"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc settings.data}" Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding DataPath}"
                                       FontFamily="{StaticResource MonoFont}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
