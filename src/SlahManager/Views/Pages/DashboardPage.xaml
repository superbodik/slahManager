<UserControl x:Class="SlahManager.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SlahManager.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,56" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="{Binding MachineLine}" Style="{StaticResource SubtitleText}"/>

            <Border Margin="0,36,0,0"
                    Padding="0,28"
                    BorderBrush="{StaticResource LineBrush}"
                    BorderThickness="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                        <TextBlock Text="{loc:Loc dashboard.profileLabel}" Style="{StaticResource LabelText}"/>
                        <TextBlock Text="{Binding ProfileTitle}"
                                   Margin="0,12,0,0"
                                   Style="{StaticResource HeadlineText}"/>
                        <TextBlock Text="{Binding ProfileSummary}"
                                   Margin="0,6,0,0"
                                   Style="{StaticResource BodyText}"/>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Margin="0,18,0,0"
                                   Style="{StaticResource CaptionMono}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" MinWidth="210" VerticalAlignment="Center">
                        <Button Content="{Binding ApplyLabel}"
                                Command="{Binding ApplyRecommendedCommand}"
                                Style="{StaticResource PrimaryButton}"/>
                        <Button Content="{loc:Loc dashboard.restorePoint}"
                                Margin="0,8,0,0"
                                Command="{Binding CreateRestorePointCommand}"
                                Style="{StaticResource GhostButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <ItemsControl Margin="0,44,0,0" ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,40">
                            <TextBlock Text="{Binding Title}" Style="{StaticResource LabelText}"/>
                            <Border Margin="0,14,0,0"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,1,0,0">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,13"
                                                    BorderBrush="{StaticResource LineBrush}"
                                                    BorderThickness="0,0,0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Value}"
                                                               TextWrapping="Wrap">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Positive">
                                                                        <Setter Property="Foreground" Value="{StaticResource PositiveBrush}"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding Tone}" Value="Warning">
                                                                        <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
