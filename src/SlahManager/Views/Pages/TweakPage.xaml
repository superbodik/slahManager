<UserControl x:Class="SlahManager.Views.Pages.TweakPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:SlahManager.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="48,40,48,56" MaxWidth="880" HorizontalAlignment="Left">
            <TextBlock Text="{Binding Title}" Style="{StaticResource DisplayText}"/>
            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SubtitleText}"/>
            <TextBlock Margin="0,36,0,14"
                       Text="{Binding Summary}"
                       Style="{StaticResource LabelText}"/>

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="0,20"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="0,0,0,1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Opacity" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                <Setter Property="Opacity" Value="0.45"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                        <TextBlock Text="{Binding Name}" FontSize="14"/>
                                        <TextBlock Margin="0,5,0,0"
                                                   Text="{Binding Description}"
                                                   Style="{StaticResource BodyText}"/>

                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding RiskLabel}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource TagText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Risk}" Value="Medium">
                                                                <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Risk}" Value="High">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{loc:Loc tweak.tag.restart}"
                                                       Style="{StaticResource TagText}"
                                                       Visibility="{Binding RebootRequired, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{loc:Loc tweak.tag.permanent}"
                                                       Style="{StaticResource TagText}"
                                                       Visibility="{Binding IsPermanent, Converter={StaticResource BoolToVisibility}}"/>
                                            <TextBlock Text="{Binding UnavailableReason}"
                                                       Style="{StaticResource TagText}"
                                                       Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVisibility}}"/>
                                        </StackPanel>

                                        <TextBlock Margin="0,10,0,0"
                                                   Text="{Binding ErrorText}"
                                                   Style="{StaticResource CaptionMono}"
                                                   Foreground="{StaticResource DangerBrush}"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <TextBlock Margin="0,0,16,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding StatusText}"
                                                   Style="{StaticResource CaptionMono}"
                                                   Foreground="{StaticResource TextMutedBrush}"/>
                                        <ToggleButton Style="{StaticResource SwitchToggle}"
                                                      IsChecked="{Binding IsApplied, Mode=OneWay}"
                                                      IsEnabled="{Binding CanToggle}"
                                                      Command="{Binding ToggleCommand}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
